# MilestonePay — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Contract ──────────────────────────────────────────────────────────────
# Deployed MilestonePayEscrow address on Arc Mainnet.
# Set this after mainnet deployment (see docs/mainnet-deployment-handoff.md).
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string for the API server and indexer.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/milestonepay

# ── API server ────────────────────────────────────────────────────────────
API_PORT=3001

# ── RPC proxy (Arc Studio managed) ────────────────────────────────────────
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# ── WalletConnect ─────────────────────────────────────────────────────────
# Get a project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ── Session secret (for future SIWE auth v2) ──────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# NEVER commit: private keys, seed phrases, Circle entity secrets, API keys,
# wallet recovery files, or any real user data.
